{
  "expo": {
    "name": "ceekay",
    "slug": "ceekay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ceekay_logo.jpeg",
    "scheme": "ceekaychem",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ceekay.chem",
      "versionCode": 1,
      "permissions": [],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47e723a6-6fb1-41ff-abe2-4a31ba9b4a2d"
      }
    }
  }
}
